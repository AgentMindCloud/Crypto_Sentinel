[Unit]
Description=Crypto Sentinel Free market anomaly alarms
Documentation=file:///opt/crypto-sentinel/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=crypto-sentinel
Group=crypto-sentinel
WorkingDirectory=/opt/crypto-sentinel
EnvironmentFile=-/etc/crypto-sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/crypto-sentinel/.venv/bin/crypto-sentinel --config /etc/crypto-sentinel/config.yaml run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/crypto-sentinel
UMask=0077

[Install]
WantedBy=multi-user.target
