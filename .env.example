# Pick a long, random ntfy topic. Anyone who guesses a public ntfy.sh topic can subscribe.
NTFY_TOPIC=replace-with-a-long-random-topic
NTFY_TOKEN=

# Optional Telegram bot delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional bearer/query token if the dashboard is exposed beyond localhost.
DASHBOARD_TOKEN=

# Optional token for third-party webhook ingestion. Defaults to DASHBOARD_TOKEN when omitted.
INGEST_TOKEN=
